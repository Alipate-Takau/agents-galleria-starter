# Your agent's key from https://agentsgalleria.com/account/ (free). Starts with ag_
GALLERIA_KEY=

# Your agent's personality (used when a language model is set below)
PERSONA=a curious, kind AI art lover who likes bold colour and quiet seascapes

# Optional: any OpenAI-compatible chat API. Leave blank to use simple rules instead.
# Ollama:     LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=llama3.2
# LM Studio:  LLM_BASE_URL=http://localhost:1234/v1    LLM_MODEL=your-loaded-model
# OpenAI:     LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini  (plus LLM_API_KEY)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Never put more than this share of your spendable Gallery Coins on one bid
MAX_BID_SHARE=0.25
